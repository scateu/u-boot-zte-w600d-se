From 03c549023193494af8df57c058fe39830ff5e505 Mon Sep 17 00:00:00 2001
From: k <k@example.com>
Date: Fri, 6 Nov 2026 17:12:19 +0800
Subject: [PATCH 5/5] board: rockchip: add ZTE W600D SE, chain-loaded from the
 vendor U-Boot

Minimal DT (UART2, eMMC, USB hosts, keyboard power GPIO3_A3 hog, USB 5 V
regulators, VOP2 takeover) and a defconfig with TEXT_BASE 0x00800000,
SYS_MEM_TOP_HIDE for the vendor logo memory, USB keyboard + vidconsole
on the panel, and the typewriter editor.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/dts/rk3568-w600d-u-boot.dtsi    |   3 +
 arch/arm/dts/rk3568-w600d.dts            | 162 +++++++++++++++++++++++
 configs/zte-w600d-chain-rk3568_defconfig |  85 ++++++++++++
 3 files changed, 250 insertions(+)
 create mode 100755 arch/arm/dts/rk3568-w600d-u-boot.dtsi
 create mode 100755 arch/arm/dts/rk3568-w600d.dts
 create mode 100755 configs/zte-w600d-chain-rk3568_defconfig

diff --git a/arch/arm/dts/rk3568-w600d-u-boot.dtsi b/arch/arm/dts/rk3568-w600d-u-boot.dtsi
new file mode 100755
index 00000000..6e8307e3
--- /dev/null
+++ b/arch/arm/dts/rk3568-w600d-u-boot.dtsi
@@ -0,0 +1,3 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+#include "rk356x-u-boot.dtsi"
diff --git a/arch/arm/dts/rk3568-w600d.dts b/arch/arm/dts/rk3568-w600d.dts
new file mode 100755
index 00000000..45730de7
--- /dev/null
+++ b/arch/arm/dts/rk3568-w600d.dts
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * ZTE W600D laptop (RK3568), U-Boot chain-loaded from the vendor U-Boot.
+ *
+ * Minimal on purpose: the vendor bootloader has already set up clocks, PMIC,
+ * panel and VOP2. Only UART2, eMMC, the USB hosts (internal keyboard on the
+ * xHCI at fd000000, low-speed 258a:0001 on its USB2 root port, powered by
+ * GPIO3_A3) and the display takeover are described here.
+ */
+
+/dts-v1/;
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include "rk3568.dtsi"
+
+/ {
+	model = "ZTE W600D (chain-loaded)";
+	compatible = "zte,w600d", "rockchip,rk3568";
+
+	aliases {
+		mmc0 = &sdhci;
+	};
+
+	chosen {
+		stdout-path = "serial2:1500000n8";
+	};
+
+	/* The window the vendor U-Boot shows the logo with (eDP on VP1) */
+	display-takeover {
+		compatible = "rockchip,rk3568-vop-takeover";
+		reg = <0x0 0xfe040000 0x0 0x3000>;
+		/* vendor drm-logo + cubic-lut reserved memory */
+		rockchip,logo-memory = <0x7df00000 0x2008000>;
+		bootph-all;
+	};
+
+	vcc5v0_host: regulator-vcc5v0-host {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0_host";
+		enable-active-high;
+		gpio = <&gpio3 RK_PA0 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc5v0_host_en>;
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+	};
+
+	vcc5v0_otg: regulator-vcc5v0-otg {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0_otg";
+		enable-active-high;
+		gpio = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc5v0_otg_en>;
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+	};
+};
+
+&combphy1 {
+	status = "okay";
+};
+
+/*
+ * Internal keyboard power: Android's ZTE "zte-gpio-ctl" driver drives this
+ * high (gpio-keyboarpower); the vendor U-Boot doesn't, so do it here.
+ */
+&gpio3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&keyboard_pwr>;
+
+	keyboard-power-hog {
+		gpio-hog;
+		gpios = <RK_PA3 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "keyboard-power";
+	};
+};
+
+&pinctrl {
+	keyboard {
+		keyboard_pwr: keyboard-pwr {
+			rockchip,pins = <3 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	usb {
+		vcc5v0_host_en: vcc5v0-host-en {
+			rockchip,pins = <3 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		vcc5v0_otg_en: vcc5v0-otg-en {
+			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
+
+&sdhci {
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	no-sd;
+	no-sdio;
+	non-removable;
+	pinctrl-names = "default";
+	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd &emmc_datastrobe>;
+	status = "okay";
+};
+
+&uart2 {
+	status = "okay";
+};
+
+/* Internal keyboard (258a:0001) */
+&usb_host1_xhci {
+	status = "okay";
+};
+
+/* Right-side USB-A port */
+&usb_host0_ehci {
+	status = "okay";
+};
+
+&usb_host0_ohci {
+	status = "okay";
+};
+
+/* Webcam */
+&usb_host1_ehci {
+	status = "okay";
+};
+
+&usb_host1_ohci {
+	status = "okay";
+};
+
+&usb2phy0 {
+	status = "okay";
+};
+
+&usb2phy0_host {
+	phy-supply = <&vcc5v0_otg>;
+	status = "okay";
+};
+
+&usb2phy1 {
+	status = "okay";
+};
+
+&usb2phy1_host {
+	phy-supply = <&vcc5v0_host>;
+	status = "okay";
+};
+
+&usb2phy1_otg {
+	phy-supply = <&vcc5v0_host>;
+	status = "okay";
+};
